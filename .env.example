# ── PROOF · environment ─────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit real credentials.

# Server
PORT=3000
DATA_DIR=data
APP_URL=http://localhost:3000

# Secrets (generate: openssl rand -hex 32)
AUTH_SECRET=

# ── AI provider (optional) ──────────────────────────────────────────
# PROOF ships with a deterministic local ProofEngine so the product
# works with zero keys. If a Google Gemini API key is set, Gemini powers
# tutoring/path copy/feedback wording with schema-validated JSON outputs,
# falling back to the local engine on any error. Scores stay engine-owned.
# Get a key: https://aistudio.google.com/apikey
AI_PROVIDER=auto            # auto | engine | gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# gemini-2.5-* models are blocked for new API keys (404 "no longer available
# to new users") — use the current GA flash model. Override freely, e.g.
# AI_MODEL=gemini-3.7-flash if you are on a key with access to newer models.
AI_MODEL=gemini-3.6-flash

# ── Supabase (production database) ──────────────────────────────────
# Get these from: https://app.supabase.com/project/_/settings/database
# DATABASE_URL is for Prisma migrations
# SUPABASE_URL and SUPABASE_ANON_KEY are for @supabase/supabase-js client
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database mode: 'store' (in-memory JSON) or 'supabase' (PostgreSQL)
DB_MODE=store

# ── Nimiq ───────────────────────────────────────────────────────────
# JSON-RPC endpoint of a Nimiq node (used for balances + on-chain payouts).
# Mainnet public RPC: https://rpc.nimiq.watch  (or run your own)
NIMIQ_RPC_URL=https://rpc.nimiq.watch
NIMIQ_NETWORK=testnet       # mainnet | testnet
# Treasury address used for on-chain reward payouts (production mode).
TREASURY_ADDRESS=
# ONLY for production on-chain payouts — never commit. Demo mode ignores this.
TREASURY_KEY=
# ── Proof integrity (anti paste / anti AI-dump) ─────────────────────
# Proofs must be hand-typed in the app. The client blocks paste/drop and
# reports keystroke telemetry; the server rejects pastes and implausible
# typing (too fast / too few edits). Set to off only for load testing.
TYPING_VERIFICATION=on

# ── Economy / anti-abuse (server-authoritative) ─────────────────────
PASS_THRESHOLD=70
DAILY_REWARD_CAP_NIM=15
DAILY_REWARDED_ATTEMPTS_CAP=12
MIN_ATTEMPT_INTERVAL_MS=45000
MAX_SUBMISSION_BYTES=200000
