# ── PROOF · environment ─────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit real credentials.

# Server
PORT=3001
DATA_DIR=data
APP_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:5173

# Production: set APP_URL=https://proof.nimagent.online and
# ALLOWED_ORIGINS=https://proof.nimagent.online,https://proofnim.vercel.app

# Secrets (generate: openssl rand -hex 32)
AUTH_SECRET=
ADMIN_SECRET=your-secure-admin-password-here

# ── Local frontend proxy ───────────────────────────────────────────
# Vite uses this target for /api requests during local development.
VITE_API_PROXY_TARGET=http://localhost:3001

# ── AI provider (optional) ──────────────────────────────────────────
# PROOF ships with a deterministic local ProofEngine so the product
# works with zero keys. If a Google Gemini API key is set, Gemini powers
# tutoring/path copy/feedback wording with schema-validated JSON outputs,
# falling back to the local engine on any error. Scores stay engine-owned.
# Get a key: https://aistudio.google.com/apikey
AI_PROVIDER=auto            # auto | engine | gemini
AI_API_KEY=
GROQ_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# gemini-2.5-* models are blocked for new API keys (404 "no longer available
# to new users") — use the current GA flash model. Override freely, e.g.
# AI_MODEL=gemini-3.7-flash if you are on a key with access to newer models.
AI_MODEL=gemini-3.6-flash

# ── Supabase (production database) ──────────────────────────────────
# Get these from: https://app.supabase.com/project/_/settings/database
# DATABASE_URL is for Prisma migrations
# SUPABASE_URL and SUPABASE_ANON_KEY are for @supabase/supabase-js client
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database mode: 'store' (in-memory JSON) or 'supabase' (PostgreSQL)
DB_MODE=store

# ── Nimiq ───────────────────────────────────────────────────────────
# JSON-RPC endpoint of a Nimiq node (used for balances + on-chain payouts).
# Mainnet public RPC: https://rpc.nimiq.watch  (or run your own)
NIMIQ_RPC_URL=https://rpc.nimiq.watch
NIMIQ_NETWORK=testnet       # mainnet | testnet
# WebSocket peer multiaddresses used by the treasury client for signed payouts.
# These are official mainnet peers; use the testnet peers from the Nimiq node
# configuration when NIMIQ_NETWORK=testnet.
NIMIQ_SEED_NODES=/dns4/aurora.seed.nimiq.com/tcp/443/wss,/dns4/catalyst.seed.nimiq.network/tcp/443/wss,/dns4/cipher.seed.nimiq-network.com/tcp/443/wss
# Treasury address used for on-chain reward payouts (production mode).
TREASURY_ADDRESS=
# Preferred: space-separated Nimiq wallet mnemonic. Never commit this value.
TREASURY_MNEMONIC=
# Optional mnemonic password/passphrase. Never commit this value.
TREASURY_MNEMONIC_PASSWORD=
# Legacy alternative: 64-character private key. Never commit this value.
TREASURY_KEY=
# ── Proof integrity (anti paste / anti AI-dump) ─────────────────────
# Proofs must be hand-typed in the app. The client blocks paste/drop and
# reports keystroke telemetry; the server rejects pastes and implausible
# typing (too fast / too few edits). Set to off only for load testing.
TYPING_VERIFICATION=on

# ── Economy / anti-abuse (server-authoritative) ─────────────────────
PASS_THRESHOLD=70
DAILY_REWARD_CAP_NIM=15
DAILY_REWARDED_ATTEMPTS_CAP=12
MIN_ATTEMPT_INTERVAL_MS=45000
# Streak reminders: in-app reminders are on by default; real micro-payouts stay off.
STREAK_REMINDER_NOTIFICATIONS_ENABLED=true
STREAK_REMINDER_PAYOUTS_ENABLED=false
STREAK_REMINDER_AMOUNT_LUNA=100
STREAK_REMINDER_COOLDOWN_DAYS=7
MAX_SUBMISSION_BYTES=200000

# ── Piper TTS (server-side, no Google billing required) ────────────
# The Dockerfile installs Piper and these voice models on Railway.
# Native browser speech is the frontend fallback if Piper is unavailable.
PIPER_BIN=/opt/piper-venv/bin/piper
PIPER_MODEL_FR=/opt/piper/fr_FR-siwis-medium.onnx
PIPER_MODEL_DE=/opt/piper/de_DE-thorsten-medium.onnx
PIPER_MODEL_ES=/opt/piper/es_ES-davefx-medium.onnx
PIPER_MODEL_ZH=/opt/piper/zh_CN-huayan-medium.onnx
PIPER_MODEL_PT=/opt/piper/pt_BR-faber-medium.onnx
PIPER_TIMEOUT_MS=15000
# Generated WAV files are reused by text/language hash. On Railway, mount a
# volume at /app/data to keep this cache across redeploys.
TTS_CACHE_DIR=data/tts-cache
